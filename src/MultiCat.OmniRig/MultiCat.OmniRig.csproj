<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net48, deliberately: .NET Framework's COM callable wrapper serves a working
    late-bound IDispatch from an out-of-process server; .NET Core's does not
    (verified by spike — Core returned a blank InterfaceVersion and a NULL Rig1).
    OmniRig clients like Log4OM read properties late-bound, so this is the only
    framework that works. The 4.8 runtime ships in Windows; nothing to install.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets net48 build without Visual Studio or a targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- System.Text.Json is built in from net6; on net48 it comes from the package. -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="OmniRig.tlb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
